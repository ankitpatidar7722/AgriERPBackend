{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "AgriERP": ""
  },

  "JwtSettings": {
    "//": "Key must be at least 32 characters - HMAC-SHA256 needs 256 bits. The API refuses to start otherwise. Replace this before any non-local deployment.",
    "Key": "",
    "Issuer": "AgriERP",
    "Audience": "AgriERP.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetMinutes": 30
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
